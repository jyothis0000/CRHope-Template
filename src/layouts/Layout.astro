---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import clashFont from "../fonts/ClashGrotesk-Variable.woff2?url";
import authorFont from "../fonts/Author-Variable.woff2?url";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Grain from "../components/Grain.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jeppesen — Branding, Web Design & Development",
  description = "At Jeppesen we build brands and websites that help you be understood and trusted as your business and brand deserve",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og/jeppesen-share.png", Astro.site);

// Where each language version of this page lives. The language switcher reads this.
const languageLinks = {
  en: { href: "/", samePage: true },
  da: { href: "/da/", samePage: true },
  es: { href: "/es/", samePage: true },
};
---

<!doctype html>
<html lang="en" class="scrollbar-none" transition:animation="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Both typefaces are on every page. Without a preload the browser only
      finds them after downloading and parsing the CSS, so text first
      renders in the fallback font and reflows when they arrive (a layout
      shift, plus extra ScrollTrigger refreshes).
    -->
    <link rel="preload" href={clashFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={authorFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Icons: .ico for legacy browsers, SVG for sharp tabs, PNGs for home screens. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f2ede4" />
    <!-- Link previews (Open Graph + X/Twitter). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jeppesen" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jeppesen asterisk isotype" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Jeppesen asterisk isotype" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="bg-neutral-100">
    <Header />
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main class="pt-40 text-neutral-900">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
    <script is:inline type="application/json" id="language-links" set:html={JSON.stringify(languageLinks)} />
    <Grain />
    <!-- Outside the smooth-scroll wrapper so position: fixed works. -->
    <CookieBanner />
  </body>
</html>

<script>
  // Smooth scrolling (ScrollSmoother) on mouse/trackpad, native scrolling on touch
  // and for reduced motion. Same-page #hash links scroll through the smoother.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ScrollSmoother } from "gsap/ScrollSmoother";
  import { FINE_POINTER_QUERY } from "../scripts/lib/pointer";

  gsap.registerPlugin(ScrollTrigger, ScrollSmoother);
  ScrollTrigger.config({ ignoreMobileResize: true });

  let media: gsap.MatchMedia | undefined;

  function teardown() {
    media?.revert();
    media = undefined;
  }

  function setup() {
    teardown();
    const wrapper = document.querySelector<HTMLElement>("#smooth-wrapper");
    const content = document.querySelector<HTMLElement>("#smooth-content");
    if (!wrapper || !content) return;

    media = gsap.matchMedia();
    media.add(`(prefers-reduced-motion: no-preference) and ${FINE_POINTER_QUERY}`, () => {
      const smoother = ScrollSmoother.create({ wrapper, content, smooth: 1.1, smoothTouch: 0, effects: false });

      // Focus or find-in-page can scroll the wrapper itself; hand that offset to the smoother.
      const onWrapperScroll = () => {
        const offset = wrapper.scrollTop;
        if (!offset) return;
        wrapper.scrollTop = 0;
        smoother.scrollTo(smoother.scrollTop() + offset, false);
      };
      wrapper.addEventListener("scroll", onWrapperScroll);

      const target = findHashTarget(window.location.hash);
      if (target) requestAnimationFrame(() => scrollToTarget(target, false));

      return () => {
        wrapper.removeEventListener("scroll", onWrapperScroll);
        smoother.kill();
      };
    });
    refreshTriggers();
  }

  // Re-measure once now and again when web fonts finish loading (text reflows).
  let waitingForFonts = false;
  function refreshTriggers() {
    ScrollTrigger.sort();
    ScrollTrigger.refresh();
    if (waitingForFonts) return;
    waitingForFonts = true;
    document.fonts.ready.then(() => {
      waitingForFonts = false;
      ScrollTrigger.sort();
      ScrollTrigger.refresh();
    });
  }

  function findHashTarget(hash: string) {
    if (hash.length < 2) return null;
    try {
      return document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return null;
    }
  }

  function scrollToTarget(target: HTMLElement, smooth: boolean) {
    const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
    const smoother = ScrollSmoother.get();
    if (smoother) {
      const contentY = Number(gsap.getProperty(smoother.content(), "y")) || 0;
      const top = target.getBoundingClientRect().top - contentY;
      smoother.scrollTo(Math.max(0, top - margin), smooth);
    } else {
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      target.scrollIntoView({ behavior: smooth && !reduced ? "smooth" : "auto", block: "start" });
    }
  }

  function onHashLinkClick(event: MouseEvent) {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
      return;
    const link = (event.target as Element | null)?.closest?.<HTMLAnchorElement>("a[href*='#']");
    if (!link || link.target === "_blank" || link.hasAttribute("download")) return;
    const url = new URL(link.href, window.location.href);
    if (
      url.origin !== window.location.origin ||
      url.pathname !== window.location.pathname ||
      url.search !== window.location.search
    )
      return;
    const target = findHashTarget(url.hash);
    if (!target) return;
    event.preventDefault();
    scrollToTarget(target, true);
  }

  document.addEventListener("click", onHashLinkClick, { capture: true });
  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", teardown);
</script>

<script>
  import "../scripts/lib/analytics";
</script>
