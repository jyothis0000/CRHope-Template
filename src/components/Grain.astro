---
// Animated film grain over the whole page.
interface Props {
  opacity?: number;
  speed?: string;
  blend?: string;
}
const { opacity = 0.6, speed = "0.9s", blend = "normal" } = Astro.props;
---

<div class="grain" aria-hidden="true" style={`--grain-opacity: ${opacity}; --grain-speed: ${speed}; --grain-blend: ${blend}`}>
  <div class="grain__layer"></div>
</div>

<style>
  .grain {
    z-index: 9999;
    pointer-events: none;
    position: fixed;
    inset: 0;
    overflow: hidden;
  }
  .grain__layer {
    width: 200%;
    height: 200%;
    opacity: var(--grain-opacity);
    mix-blend-mode: var(--grain-blend);
    will-change: transform;
    animation: grain var(--grain-speed) steps(6) infinite;
    background-image: url(/noise.png);
    background-repeat: repeat;
    position: absolute;
    inset: -50%;
  }
  @keyframes grain {
    0%,
    to {
      transform: translate(0);
    }
    17% {
      transform: translate(-5%, -10%);
    }
    33% {
      transform: translate(3%, -15%);
    }
    50% {
      transform: translate(12%, 9%);
    }
    67% {
      transform: translate(9%, 4%);
    }
    83% {
      transform: translate(-1%, 7%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .grain__layer {
      animation: none;
    }
  }
</style>
