---
import WriteOnText from "./WriteOnText.astro";
---

<section id="mission" aria-label="Our mission" class="mt-[10vw] mb-[24vw] px-site-margin sm:mt-[46vw] sm:mb-[8vw]">
  <div class="grid grid-cols-12 gap-gutter mx-auto max-w-none">
    <WriteOnText
      class="max-w-350 pt-[14vw] col-start-2 col-end-11 max-md:col-start-1 max-md:col-end-13"
      start="top 65%"
      end="top 25%"
      text="Every child deserves the opportunity to reach their full potential."
    />
  </div>
</section>
