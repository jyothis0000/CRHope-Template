---
// The isotype embossed into (or raised from) the page with three.js on a canvas.
// The canvas fades in once ready; if WebGL fails, the flat image shows instead.
// three.js only loads when the isotype is near the screen (or the browser is idle).
interface Props {
  /** SVG the relief is built from (also the fallback image). */
  src: string;
  /** Accessible name. */
  label: string;
  relief?: "raised" | "carved";
  color?: string;
  size?: number;
  depth?: number;
  bevel?: number;
  shadow?: number;
  travel?: number;
  softness?: number;
  lerp?: number;
  bounce?: number;
  class?: string;
}

const { src, label, relief, color, size, depth, bevel, shadow, travel, softness, lerp, bounce, class: className } = Astro.props;
---

<div
  class:list={["embossed-isotype relative size-full", className]}
  role="img"
  aria-label={label}
  data-embossed-isotype
  data-src={src}
  data-relief={relief}
  data-color={color}
  data-size={size}
  data-depth={depth}
  data-bevel={bevel}
  data-shadow={shadow}
  data-travel={travel}
  data-softness={softness}
  data-lerp={lerp}
  data-bounce={bounce}
>
  <canvas class="embossed-isotype__canvas absolute inset-0 block size-full" aria-hidden="true"></canvas><img
    src={src}
    alt=""
    aria-hidden="true"
    class="embossed-isotype__fallback absolute inset-0 m-auto hidden w-[40%] opacity-20"
  />
</div>

<script>
  import type { EmbossedIsotype } from "../scripts/lib/embossedIsotype";

  let instances: EmbossedIsotype[] = [];
  // Bumped on every teardown, so mounts still awaiting the module after a page swap bail out.
  let generation = 0;
  let observer: IntersectionObserver | undefined;
  let cancelPrefetch: (() => void) | undefined;

  const toNumber = (value: string | undefined) => (value === undefined || value === "" ? undefined : Number(value));
  const loadModule = () => import("../scripts/lib/embossedIsotype");

  // Fetch three.js while the browser is idle, before the isotype is scrolled near.
  function prefetchWhenIdle() {
    const load = () => void loadModule().catch(() => {});
    if (typeof window.requestIdleCallback === "function") {
      const id = window.requestIdleCallback(load, { timeout: 4000 });
      cancelPrefetch = () => window.cancelIdleCallback(id);
    } else {
      const id = window.setTimeout(load, 2000);
      cancelPrefetch = () => window.clearTimeout(id);
    }
  }

  function teardown() {
    generation++;
    observer?.disconnect();
    observer = undefined;
    cancelPrefetch?.();
    cancelPrefetch = undefined;
    instances.forEach((instance) => instance.destroy());
    instances = [];
  }

  function setup() {
    teardown();
    const roots = document.querySelectorAll<HTMLElement>("[data-embossed-isotype]");
    if (!roots.length) return;
    const currentGeneration = generation;
    if (!("IntersectionObserver" in window)) {
      roots.forEach((root) => void mount(root, currentGeneration));
      return;
    }
    prefetchWhenIdle();
    observer = new IntersectionObserver(
      (entries, io) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          mount(entry.target as HTMLElement, currentGeneration);
        });
      },
      { rootMargin: "200% 0px" },
    );
    roots.forEach((root) => observer?.observe(root));
  }

  async function mount(root: HTMLElement, mountGeneration: number) {
    const { EmbossedIsotype } = await loadModule();
    if (mountGeneration !== generation) return;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canvas = root.querySelector("canvas");
    if (!canvas) return;

    const data = root.dataset;
    const isotype = new EmbossedIsotype(canvas, {
      src: data.src,
      relief: data.relief === "raised" ? "raised" : "carved",
      color: data.color || "auto",
      size: toNumber(data.size),
      depth: toNumber(data.depth),
      bevel: toNumber(data.bevel),
      shadow: toNumber(data.shadow),
      travel: toNumber(data.travel),
      softness: toNumber(data.softness),
      lerp: toNumber(data.lerp),
      bounce: toNumber(data.bounce),
      reducedMotion,
      onReady: () => root.classList.add("is-ready"),
    });
    instances.push(isotype);
    isotype.init().catch((error) => {
      console.warn("[EmbossedIsotype] falling back to flat SVG:", error);
      isotype.destroy();
      root.classList.add("is-fallback");
    });
  }

  document.addEventListener("astro:page-load", setup);
  document.addEventListener("astro:before-swap", teardown);
</script>

<style>
  .embossed-isotype__canvas {
    opacity: 0;
    transition: opacity 0.8s;
  }
  .embossed-isotype.is-ready .embossed-isotype__canvas {
    opacity: 1;
  }
  .embossed-isotype.is-fallback .embossed-isotype__fallback {
    display: block;
  }
</style>
