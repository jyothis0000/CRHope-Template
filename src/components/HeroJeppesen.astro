---
// Home hero: the JEPPESEN wordmark assembles from its letters, then the title,
// intro copy and intro video fade in. The video grows into the grid on scroll.
---

<div class="relative -mt-40 min-h-svh pt-40">
  <div class="grid grid-cols-12 gap-gutter mx-auto max-w-none pointer-events-none absolute inset-x-0 top-0 px-site-margin">
    <div id="intro-video-grid-target" class="col-start-2 col-end-12 h-px" aria-hidden="true"></div>
  </div>
  <div id="jeppesen" class="absolute w-1/2 left-1/4" style="top: calc(50vh - 100vw / 15.2); height: calc(50vw / 7.6); transform-origin: bottom">
    <div>
      <img
        id="logoj"
        src="/logo-files/logo-J.svg"
        alt="Jeppesen Logo J"
        class="absolute w-[11.2%] opacity-0"
        style="transform: translateY(35vh)"
      />
      <div
        id="e-asterisk"
        class="absolute w-[11.4%] left-[12.4%] h-[49.5%]"
        style="top: -70vh; transform: rotate(-90deg); transform-origin: bottom left"
      >
        <img id="logoe" src="/logo-files/logo-E.svg" alt="Jeppesen Logo E" class="w-full" /><img
          id="logoasterisk"
          src="/logo-files/logo-Asterisc.svg"
          alt="Jeppesen Logo Asterisk"
          class="relative w-[56%]"
          style="top: -4.9vw; left: 36%"
        />
      </div>
      <img
        id="ppesen"
        src="/logo-files/logo-PPESEN.svg"
        alt="Jeppesen Logo Rest"
        class="absolute w-[75.6%] left-[24.8%]"
        style="clip-path: polygon(100% 0%, 100% 0%, 100% 100%, 100% 100%)"
      />
    </div>
  </div>
  <section
    class="px-site-margin pt-8 md:pt-[2vh] 2giga:pt-[6vh] pb-[15vw] sm:pb-[2.7vw] sm:pr-[2.7vw] flex flex-col z-20"
    style="min-height: calc(100vh - 100vw / 7.6 - 140px)"
  >
    <h1 id="big-title" class="w-full sm:w-4/5 pb-[2.5svh] opacity-0">
      <span class="block type-clash-semibold-xl">Your work is exceptional.</span><span class="block type-clash-regular-xl"
        >Your brand and website should be too.</span
      >
    </h1>
    <div id="rest-page" class="flex flex-row justify-between grow opacity-0">
      <p class="w-4/12 type-author-medium-18 hidden sm:block max-w-160">
        Jeppesen is a one-partner studio for strategy, identity, motion and web. We craft brands and websites that live up to the
        quality of your work and make you easier to understand, trust and choose.
      </p>
      <!--
          H.264: Safari (iOS and macOS) can't play VP9 in an MP4, which
          left only the empty light frame on iPhones.
        -->
      <div id="intro-video" class="intro-video absolute right-[2.7vw] w-[94.6vw] sm:w-[22%] h-auto border-8 border-background rounded-lg">
        <video
          src="/intro-video.mp4"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          disablepictureinpicture
          class="block aspect-video w-full h-auto rounded-lg object-cover"></video>
      </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const FULL_CLIP = "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)";
  const FINAL_LOGO_TOP = "calc(100svh - 100vw/15.3)";

  let context: gsap.Context | undefined;
  let media: gsap.MatchMedia | undefined;
  let videoObserver: IntersectionObserver | undefined;

  // Pause the intro video while it is off screen; resume it only if we paused it.
  function watchIntroVideo() {
    const video = document.querySelector<HTMLVideoElement>("#intro-video video");
    if (!video || !("IntersectionObserver" in window)) return;
    let visible = true;
    let pausedOffscreen = false;

    videoObserver = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        if (visible) {
          if (pausedOffscreen) {
            pausedOffscreen = false;
            video.play().catch(() => {});
          }
        } else if (!video.paused) {
          pausedOffscreen = true;
          video.pause();
        }
      },
      { rootMargin: "200px 0px" },
    );
    videoObserver.observe(video);

    // Autoplay may kick in after the hero has already scrolled away.
    video.addEventListener(
      "play",
      () => {
        if (!visible) {
          pausedOffscreen = true;
          video.pause();
        }
      },
      { once: true },
    );
  }

  // Jump straight to the end of the intro animation.
  function showFinalState() {
    gsap.set("#e-asterisk", { y: "70vh", rotate: 0 });
    gsap.set("#logoj", { y: 0, opacity: 1 });
    gsap.set("#logoasterisk", { x: 0 });
    gsap.set("#ppesen", { clipPath: FULL_CLIP });
    gsap.set("#jeppesen", { scale: 2, top: FINAL_LOGO_TOP });
    gsap.set("#big-title", { opacity: 1 });
    gsap.set("#rest-page", { opacity: 1 });
  }

  function teardown() {
    videoObserver?.disconnect();
    videoObserver = undefined;
    media?.revert();
    media = undefined;
    context?.revert();
    context = undefined;
  }

  function init() {
    teardown();
    if (!document.getElementById("jeppesen")) return;
    watchIntroVideo();
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const win = window as Window & { __jeppesenPlayed?: boolean };

    context = gsap.context(() => {
      // The intro plays once per visit; later client-side navigations show the end state.
      if (reducedMotion || win.__jeppesenPlayed) {
        showFinalState();
        return;
      }
      const timeline = gsap.timeline();
      timeline.to("#e-asterisk", { y: "70vh", duration: 0.8, ease: "back.out(1)" });
      timeline.to("#logoj", { y: 0, opacity: 1, duration: 0.5, ease: "back.out(0.5)" }, "-=35%");
      timeline.to("#e-asterisk", { rotate: 0, duration: 0.4, ease: "back.out(0.5)" }, "-=100%");
      timeline.to("#logoasterisk", { x: "45vw", duration: 1.5, yoyo: true, repeat: 1, ease: "power4.inOut" }, "-=28%");
      timeline.to("#ppesen", { clipPath: FULL_CLIP, ease: "power1.in", duration: 0.6 }, "-=170%");
      timeline.to("#jeppesen", { scale: 2, top: FINAL_LOGO_TOP, duration: 0.6, ease: "power2.out" });
      timeline.to("#big-title", { opacity: 1, duration: 0.4 });
      timeline.to("#rest-page", { opacity: 1, duration: 0.4 }, "-=75%");
      win.__jeppesenPlayed = true;
    });

    if (reducedMotion) return;

    // From 680px the video scrubs down and widens to the grid's inner columns.
    media = gsap.matchMedia();
    media.add("(min-width: 680px)", () => {
      const video = document.querySelector<HTMLElement>("#intro-video");
      const target = document.querySelector<HTMLElement>("#intro-video-grid-target");
      const container = video?.offsetParent;
      if (!video || !target || !(container instanceof HTMLElement)) return;

      gsap.to(video, {
        width: () => target.getBoundingClientRect().width,
        right: () => container.getBoundingClientRect().right - target.getBoundingClientRect().right,
        y: "66vw",
        scrollTrigger: {
          trigger: video,
          start: "top 40%",
          end: "bottom top",
          scrub: true,
          invalidateOnRefresh: true,
        },
      });
    });
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", teardown);
</script>

<style>
  .intro-video {
    bottom: calc(13.1579vw + 20px);
  }
  @media (max-width: 39.99rem) {
    .intro-video {
      top: calc(100svh - 13.1579vw - 20px);
      bottom: auto;
      translate: 0 -100%;
    }
  }
</style>
