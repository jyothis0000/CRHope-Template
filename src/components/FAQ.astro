---
// FAQ accordion in a dark section, plus matching FAQPage structured data.
// Answers are trusted HTML (they may contain links).
import DarkReveal from "./DarkReveal.astro";
import { site } from "../data/site";

const faqs = [
  {
    question: "What is CR HOPE Foundation?",
    answer: `CR HOPE (Cosiano Renos HOPE) is a not-for-profit charity launched in 2017 with one objective: providing quality education to children and youth in Zanzibar, Tanzania, and so fighting poverty in the region. License No. ${site.license}.`,
  },
  {
    question: "Where is the Seeds of Light school?",
    answer: `In the village of Kizimkazi, Mkunguni, in Zanzibar. It opened in January 2020 on land donated by our co-founder, Cosiano Ismail Mbise, so local children could learn for free.`,
  },
  {
    question: "How many children do you support?",
    answer: `Seeds of Light currently serves 180 students aged 3 to 13 and employs 13 local teachers. Children build literacy and numeracy skills, and we spur their interest in sports, community development and leadership.`,
  },
  {
    question: "Why focus on education?",
    answer: `Africa has the highest rate of non-educated individuals, and with the high levels of poverty in Tanzania most parents can’t afford to send their children to school, even at primary level. Quality education is the most lasting way we know to change that.`,
  },
  {
    question: "How can I donate?",
    answer: `Give through our <a href="${site.donateUrl}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 !text-neutral-100">GlobalGiving page</a> or via <a href="${site.paypalUrl}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 !text-neutral-100">PayPal</a>. A donation of even $1 makes a difference and helps build a better future for the children of Zanzibar.`,
  },
  {
    question: "Can I volunteer at the school?",
    answer: `Yes. Volunteers help with arts and crafts, sports, music, hygiene lessons, playground supervision and community projects like tree planting. You don’t need specialised experience or certifications, just passion and dedication. <a href="${site.volunteerUrl}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 !text-neutral-100">Apply to volunteer</a>.`,
  },
  {
    question: "What does a volunteer’s week look like?",
    answer: `Volunteers teach five days a week, with weekends and holidays free. A member of staff meets you at Abeid Amani Karume International Airport in Zanzibar, orientation happens the next day, and the volunteer guest house is your base during your stay.`,
  },
  {
    question: "Is there a fee to volunteer?",
    answer: `There is a program fee that depends on the length of your stay, plus an $80 application and placement booking fee. It covers administration, placement booking and confirmation, pre-departure support and 24-hour international HQ back-up. Questions? Email <a href="mailto:${site.email}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 !text-neutral-100">${site.email}</a>.`,
  },
  {
    question: "How can my company partner with CR HOPE?",
    answer: `Companies can partner with us as part of their Corporate Social Responsibility initiatives. We stay transparent and track our projects continuously, so partners always know the impact of their support. <a href="${site.partnerUrl}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 !text-neutral-100">Become a partner</a>.`,
  },
  {
    question: "Are you aligned with the UN Sustainable Development Goals?",
    answer: `Yes. CR HOPE aligns its activities with the UN Sustainable Development Goals and has pledged to help end poverty, expand access to education, reduce gender inequality and support global sustainability.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(({ question, answer }) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
};
// Escape "<" so nothing in the data can close the <script> early.
const faqJsonLd = JSON.stringify(faqSchema).replace(/</g, "\\u003c");
---

<DarkReveal id="faq" aria-label="Frequently asked questions">
  <div class="grid grid-cols-12 gap-gutter mx-auto max-w-none w-full">
    <div class="col-span-12 grid grid-cols-1 gap-x-gutter gap-y-10 lg:col-span-10 lg:col-start-2 lg:grid-cols-10">
      <!--
        Visual (cols 2–5 in the design). Pass another visual in the "visual"
        slot to replace it. Hidden below lg, so the lazy image is never
        downloaded on mobile.
      -->
      <div data-dark-item aria-hidden="true" class="hidden aspect-[3/4] overflow-hidden rounded-lg bg-neutral-900 lg:col-span-4 lg:block">
        <slot name="visual">
          <img
            src="/images/faq-classroom.jpg"
            width="900"
            height="578"
            alt=""
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </slot>
      </div>
      <div class="min-w-0 lg:col-span-6">
        <h2 data-dark-item="text" class="overflow-hidden type-clash-semibold-32 mb-4">
          <span data-reveal-inner class="block">Frequently asked questions</span>
        </h2>
        <ul data-faq data-dark-item="stagger" data-cta-section="home_faq" class="space-y-1.5">
          {
            faqs.map(({ question, answer }, index) => (
              <li
                data-dark-child
                data-faq-item
                class="rounded-lg border border-neutral-700 transition-colors duration-500 ease-in-out motion-reduce:transition-none hover:bg-neutral-100/5 has-[:focus-visible]:bg-neutral-100/5"
              >
                <h3>
                  <button
                    type="button"
                    id={`faq-trigger-${index}`}
                    data-faq-trigger
                    aria-expanded="false"
                    aria-controls={`faq-panel-${index}`}
                    class="type-author-semibold-16 flex w-full cursor-pointer items-center justify-between gap-6 px-5 py-3 text-left text-neutral-100 transition-[padding] duration-300 ease-in-out motion-reduce:transition-none aria-expanded:pt-5 aria-expanded:pb-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-100"
                  >
                    <span>{question}</span>
                    <span aria-hidden="true" class="relative h-2.5 w-2.5 shrink-0">
                      <span class="absolute top-1/2 left-0 h-px w-full -translate-y-1/2 bg-current" />
                      <span
                        data-faq-icon-v
                        class="absolute top-0 left-1/2 h-full w-px -translate-x-1/2 bg-current transition-transform duration-300 ease-in-out motion-reduce:transition-none"
                      />
                    </span>
                  </button>
                </h3>
                <div
                  id={`faq-panel-${index}`}
                  role="region"
                  aria-labelledby={`faq-trigger-${index}`}
                  data-faq-panel
                  class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out motion-reduce:transition-none"
                >
                  <div class="overflow-hidden">
                    <p class="type-author-medium-18 !text-neutral-100/75 max-w-[60ch] px-5 pb-5" set:html={answer} />
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</DarkReveal>
<script type="application/ld+json" set:html={faqJsonLd} />
<!-- Without JavaScript, show every answer. --><noscript
  ><style is:inline>
    [data-faq-panel] {
      grid-template-rows: 1fr !important;
    }
  </style></noscript
>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // How long a panel's open/close transition runs (CSS duration-300 plus slack).
  const SETTLE_MS = 450;

  function initFaq() {
    const list = document.querySelector<HTMLElement>("[data-faq]");
    if (!list || list.dataset.faqReady) return;
    list.dataset.faqReady = "true";
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-faq-item]"));
    const darkSection = list.closest("[data-dark-reveal]");
    let settleUntil = 0;
    let frame = 0;

    // The dark reveal's background tracks the section height, so refresh its
    // (non-pin) triggers every frame while a panel animates.
    function refreshSectionTriggers() {
      if (!darkSection) return;
      ScrollTrigger.getAll()
        .filter((trigger) => trigger.trigger === darkSection && !trigger.pin)
        .forEach((trigger) => trigger.refresh());
      ScrollTrigger.update();
    }

    function followHeightChange() {
      settleUntil = performance.now() + SETTLE_MS;
      if (frame) return;
      const tick = () => {
        refreshSectionTriggers();
        if (performance.now() < settleUntil) {
          frame = requestAnimationFrame(tick);
          return;
        }
        frame = 0;
        ScrollTrigger.refresh();
      };
      frame = requestAnimationFrame(tick);
    }

    // Returns the panel when its state changed, otherwise false.
    function setOpen(item: HTMLElement, open: boolean) {
      const trigger = item.querySelector("[data-faq-trigger]");
      const panel = item.querySelector<HTMLElement>("[data-faq-panel]");
      const icon = item.querySelector("[data-faq-icon-v]");
      if (!trigger || !panel) return false;
      const wasOpen = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("grid-rows-[1fr]", open);
      panel.classList.toggle("grid-rows-[0fr]", !open);
      icon?.classList.toggle("rotate-90", open);
      panel.inert = !open;
      return wasOpen !== open && panel;
    }

    items.forEach((item) => setOpen(item, false));

    // One answer open at a time: clicking opens this item and closes the rest.
    items.forEach((item) => {
      const trigger = item.querySelector("[data-faq-trigger]");
      trigger?.addEventListener("click", () => {
        const isOpen = trigger.getAttribute("aria-expanded") === "true";
        let changed: HTMLElement | false | null = null;
        for (const other of items) {
          const result = setOpen(other, other === item && !isOpen);
          if (result) changed = result;
        }
        if (changed) followHeightChange();
      });
    });
  }

  initFaq();
  document.addEventListener("astro:page-load", initFaq);
</script>
